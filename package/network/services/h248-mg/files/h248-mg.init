#!/bin/sh /etc/rc.common
START=90
USE_PROCD=1

start_service() {
	local enabled mgc port local device rtp
	config_load h248-mg
	config_get_bool enabled main enabled 0
	[ "$enabled" = "1" ] || return 0
	config_get mgc main mgc_host ''
	config_get port main mgc_port 2944
	config_get local main local_port 2944
	config_get rtp main rtp_port 5004
	config_get device main device /dev/en75xx-fxs0
	[ -n "$mgc" ] || { logger -t h248-mg "no MGC host configured"; return 1; }

	procd_open_instance
	procd_set_param command /usr/bin/erl -noshell \
		-pa /usr/lib/erlang/lib/h248_mg-0.1/ebin \
		-eval 'h248_mg:start(), timer:sleep(infinity).'
	procd_set_param env H248_MGC="$mgc" H248_MGC_PORT="$port" H248_LOCAL_PORT="$local" H248_DEVICE="$device" H248_RTP_PORT="$rtp"
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 0
	procd_set_param stderr 0
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger "h248-mg"
}
