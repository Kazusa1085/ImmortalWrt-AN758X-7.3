#!/bin/sh

uci -q set asterisk.general.enabled='1'
uci -q set asterisk.general.interface=''
uci -q commit asterisk

# Apply the voice-profile DSP switches to the kernel modules.  Both knobs
# already exist in en75xx_pcm; this is the missing boot-time glue.
apply_dsp_param() {
	local param="$1" value="$2"

	[ -n "$value" ] || return 0
	[ -w "/sys/module/en75xx_pcm/parameters/$param" ] || return 0
	printf '%s\n' "$value" > "/sys/module/en75xx_pcm/parameters/$param"
}

country=$(uci -q get onu-voice.config.country)
[ -n "$country" ] || country=cn
ec=$(uci -q get onu-voice.config.echo_cancellation)
[ -n "$ec" ] || ec=1
agc=$(uci -q get onu-voice.config.agc)
[ -n "$agc" ] || agc=0

apply_dsp_param lec_enable "$ec"
apply_dsp_param alc_enable "$agc"
bypass=$(uci -q get onu-voice.config.lec_bypass)
[ -n "$bypass" ] || bypass=0
apply_dsp_param lec_bypass "$bypass"

indications=/etc/asterisk/indications.conf
if [ -f "$indications" ]; then
	cn_include='#include "indications-en75xx.conf"'
	if ! grep -qxF "$cn_include" "$indications"; then
		printf '\n%s\n' "$cn_include" >> "$indications"
	fi
	if grep -q '^[[:space:]]*country=' "$indications"; then
		sed -i "s/^[[:space:]]*country=.*/country=$country\t\t; selected voice region/" "$indications"
	else
		printf '\ncountry=%s\t\t; selected voice region\n' "$country" >> "$indications"
	fi
fi

musiconhold=/etc/asterisk/musiconhold.conf
if [ -f "$musiconhold" ]; then
	moh_include='#include "musiconhold-en75xx.conf"'
	if ! grep -qxF "$moh_include" "$musiconhold"; then
		printf '\n%s\n' "$moh_include" >> "$musiconhold"
	fi
fi

pjsip=/etc/asterisk/pjsip.conf
if [ -f "$pjsip" ]; then
	pjsip_include='#include "pjsip-en75xx.conf"'
	if ! grep -qxF "$pjsip_include" "$pjsip"; then
		printf '\n%s\n' "$pjsip_include" >> "$pjsip"
	fi
fi

features=/etc/asterisk/features.conf
if [ -f "$features" ]; then
	feature_include='#include "features-en75xx.conf"'
	if ! grep -qxF "$feature_include" "$features"; then
		printf '\n%s\n' "$feature_include" >> "$features"
	fi
fi

extensions=/etc/asterisk/extensions.conf
include='#include "extensions-en75xx.conf"'

if [ -f "$extensions" ]; then
	generated_include='#include "extensions-en75xx-generated.conf"'
	if ! grep -qxF "$include" "$extensions"; then
		printf '\n%s\n' "$include" >> "$extensions"
	fi
	if ! grep -qxF "$generated_include" "$extensions"; then
		printf '%s\n' "$generated_include" >> "$extensions"
	fi
fi

[ ! -x /etc/init.d/asterisk ] || /etc/init.d/asterisk enable

exit 0
