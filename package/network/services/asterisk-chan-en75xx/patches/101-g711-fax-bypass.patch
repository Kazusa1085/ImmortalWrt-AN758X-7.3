@@ -297,6 +297,17 @@ static void start_dialtone(struct en75xx_pvt *p, struct ast_channel *chan)
  * during fax negotiation. Suspend it for the switch, restore it once
  * there is a real conversation to level.
  */
+static void line_set_lec_bypass(int enable)
+{
+	int fd = open("/sys/module/en75xx_pcm/parameters/lec_bypass", O_WRONLY);
+	char value = enable ? '1' : '0';
+
+	if (fd >= 0) {
+		(void)write(fd, &value, 1);
+		close(fd);
+	}
+}
