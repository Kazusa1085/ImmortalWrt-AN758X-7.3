diff --git a/src/en75xx_pcm.c b/src/en75xx_pcm.c
index 5288bc5..05653e0 100644
--- a/src/en75xx_pcm.c
+++ b/src/en75xx_pcm.c
@@ -10,6 +10,8 @@
 #include <linux/bitfield.h>
 #include <linux/build_bug.h>
 #include <linux/delay.h>
+#include <linux/debugfs.h>
+#include <linux/seq_file.h>
 #include <linux/dma-mapping.h>
 #include <linux/interrupt.h>
 #include <linux/io.h>
@@ -40,6 +42,10 @@ static bool lec_enable;
 module_param_named(lec_enable, lec_enable, bool, 0644);
 MODULE_PARM_DESC(lec_enable, "Enable OSLEC line echo cancellation on the RX path");
 
+static bool lec_bypass;
+module_param_named(lec_bypass, lec_bypass, bool, 0644);
+MODULE_PARM_DESC(lec_bypass, "Bypass OSLEC while fax/modem negotiation is active");
+
 /*
  * 128 samples = 16ms at 8kHz, shorter than any of the vendor's own
  * documented echo-canceller tail-length options (MediaTek ADAM API:
@@ -198,6 +204,10 @@ struct en75xx_pcm_dev {
 	int irq;
 	struct mutex lock;
 	struct delayed_work poll_work;
+	struct dentry *debugfs_dir;
+	atomic64_t lec_frames;
+	atomic64_t lec_bypass_frames;
+	atomic64_t alc_frames;
 	void *tx_ring;
 	void *rx_ring;
 	dma_addr_t tx_ring_dma;
@@ -610,7 +620,10 @@ process_dsp:
 		ch->lec_active = READ_ONCE(lec_enable);
 		oslec_flush(ch->lec);
 	}
-	if (ch->lec && ch->lec_active && index < EN75XX_PCM_MAX_RING_COUNT) {
+	if (ch->lec && ch->lec_active && READ_ONCE(lec_bypass))
+		atomic64_inc(&pcm->lec_bypass_frames);
+	if (ch->lec && ch->lec_active && !READ_ONCE(lec_bypass) &&
+	    index < EN75XX_PCM_MAX_RING_COUNT) {
 		for (i = 0; i < EN75XX_PCM_FRAME_SAMPLES; i++) {
 			s16 rx = get_unaligned_le16(tmp + i * 2);
 			s16 tx = ch->tx_desc_ref[index][i];
@@ -619,10 +632,12 @@ process_dsp:
 					   tmp + i * 2);
 		}
 		data = tmp;
+		atomic64_inc(&pcm->lec_frames);
 	}
 
 	if (do_alc) {
 		en75xx_pcm_voice_autogain(ch, (s16 *)tmp, EN75XX_PCM_FRAME_SAMPLES);
+		atomic64_inc(&pcm->alc_frames);
 		data = tmp;
 	}
 
@@ -1212,6 +1227,18 @@ void en75xx_pcm_put(struct en75xx_pcm *pcm)
 }
 EXPORT_SYMBOL_GPL(en75xx_pcm_put);
 
+static int en75xx_pcm_stats_show(struct seq_file *m, void *private)
+{
+	struct en75xx_pcm_dev *pcm = m->private;
+
+	seq_printf(m, "lec_frames=%llu\nlec_bypass_frames=%llu\nalc_frames=%llu\n",
+		   atomic64_read(&pcm->lec_frames),
+		   atomic64_read(&pcm->lec_bypass_frames),
+		   atomic64_read(&pcm->alc_frames));
+	return 0;
+}
+DEFINE_SHOW_ATTRIBUTE(en75xx_pcm_stats);
+
 static int en75xx_pcm_probe(struct platform_device *pdev)
 {
 	static const u32 default_slots[EN75XX_PCM_SLOT_REGS] = {
@@ -1375,6 +1402,7 @@ static void en75xx_pcm_remove(struct platform_device *pdev)
 	struct en75xx_pcm_dev *pcm = platform_get_drvdata(pdev);
 	unsigned int channel;
 
+	debugfs_remove_recursive(pcm->debugfs_dir);
 	en75xx_pcm_unregister(&pcm->pub);
 	cancel_delayed_work_sync(&pcm->poll_work);
 	mutex_lock(&pcm->lock);
